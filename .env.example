# ==============================================================================
# Job Hunter Agent - Environment Configuration (India Job Market Localization)
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=production
PORT=5000
CLIENT_PORT=80
CLIENT_ORIGIN=http://localhost

# Target Job Market Localization
DEFAULT_COUNTRY=in

# Database Configuration (MongoDB Atlas Cluster or Local Container)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.kkhsodn.mongodb.net/jobhunter?retryWrites=true&w=majority&appName=Cluster0
# For local Docker Compose container fallback:
# MONGO_URI=mongodb://mongo:27017/jobhunter

# Google Gemini API Configuration (ATS Resume Parsing)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Job Aggregation APIs (Localized for Indian Tech Hubs: Bengaluru, Pune, Hyderabad, Noida, Gurugram)
# RapidAPI JSearch: https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Adzuna API (India Endpoint: /jobs/in/search/1): https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# Nodemailer SMTP Configuration (Job Alert Digest Emails)
# If left empty, an Ethereal test inbox link will be generated in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="Job Hunter Agent" <no-reply@jobhunteragent.io>

# Cron Worker Schedule (Standard 5-part cron syntax: Default every 6 hours)
CRON_SCHEDULE="0 */6 * * *"
MATCH_THRESHOLD=70
